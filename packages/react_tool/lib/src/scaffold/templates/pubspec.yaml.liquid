name: {{ name }}
description: A React Dart application with server-side rendering.
publish_to: none

environment:
  sdk: ">=3.12.0 <4.0.0"

dependencies:
  react: {path: {{ packagesPath }}/react}
  react_js: {path: {{ packagesPath }}/react_js}
  react_dom: {path: {{ packagesPath }}/react_dom}
  react_web: {path: {{ packagesPath }}/react_web}
  react_actions: {path: {{ packagesPath }}/react_actions}
  react_server: {path: {{ packagesPath }}/react_server}
  react_server_shelf: {path: {{ packagesPath }}/react_server_shelf}
  shelf: ^1.4.0
  shelf_static: ^1.1.3

dev_dependencies:
  build_runner: ^2.15.3
  react_codegen: {path: {{ packagesPath }}/react_codegen}
  react_tool: {path: {{ packagesPath }}/react_tool}
  react_testing: {path: {{ packagesPath }}/react_testing}
  lints: ^6.1.0
  test: ^1.31.2
  server_testing: 0.4.0
  server_testing_shelf: 0.4.0

# The react_* packages are not published yet, so every project depends on
# them by path. The overrides keep a path package (for example react_dom's
# bare `react:` entry) resolving against the local copies.
dependency_overrides:
  react: {path: {{ packagesPath }}/react}
  react_js: {path: {{ packagesPath }}/react_js}
  react_dom: {path: {{ packagesPath }}/react_dom}
  react_web: {path: {{ packagesPath }}/react_web}
  react_actions: {path: {{ packagesPath }}/react_actions}
  react_server: {path: {{ packagesPath }}/react_server}
  react_server_shelf: {path: {{ packagesPath }}/react_server_shelf}
  react_testing: {path: {{ packagesPath }}/react_testing}
