name: {{ name }}
description: A React Dart application with server-side rendering.
publish_to: none

environment:
  sdk: ">=3.13.0 <4.0.0"

dependencies:
  react_core: ^0.1.0
  react_js: ^0.1.0
  react_dom: ^0.1.0
  react_web: ^0.1.1
  react_actions: ^0.1.1
  react_server: ^0.1.1
  react_server_shelf: ^0.1.1
  shelf: ^1.4.0
  shelf_static: ^1.1.3

dev_dependencies:
  build_runner: ^2.15.3
  build_web_compilers: ^4.8.10
  webdev: ^4.0.2
  react_codegen: ^0.1.0
  react_tool: ^0.2.4
  react_testing: ^0.1.0
  lints: ^6.1.0
  test: ^1.31.2
  server_testing: ^0.4.0
  server_testing_shelf: ^0.4.0

{% if localPackages %}
# Local workspace overrides are enabled when `--packages` is supplied.
dependency_overrides:
  react_core: {path: {{ packagesPath }}/react_core}
  react_js: {path: {{ packagesPath }}/react_js}
  react_dom: {path: {{ packagesPath }}/react_dom}
  react_web: {path: {{ packagesPath }}/react_web}
  react_actions: {path: {{ packagesPath }}/react_actions}
  react_server: {path: {{ packagesPath }}/react_server}
  react_server_shelf: {path: {{ packagesPath }}/react_server_shelf}
  react_testing: {path: {{ packagesPath }}/react_testing}
{% endif %}
