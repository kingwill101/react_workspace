name: {{ name }}
description: A React Dart application (SSR) hosted with Routed.
publish_to: none

environment:
  sdk: ">=3.12.0 <4.0.0"

dependencies:
  react_core: {path: {{ packagesPath }}/react_core}
  react_js: {path: {{ packagesPath }}/react_js}
  react_dom: {path: {{ packagesPath }}/react_dom}
  react_web: {path: {{ packagesPath }}/react_web}
  react_actions: {path: {{ packagesPath }}/react_actions}
  react_server: {path: {{ packagesPath }}/react_server}
  react_server_routed:
    path: {{ packagesPath }}/react_server_routed
  routed_core:
    git:
      url: https://github.com/kingwill101/routed.git
      ref: master
      path: packages/routed_core
  routed_io:
    git:
      url: https://github.com/kingwill101/routed.git
      ref: master
      path: packages/routed_io

dev_dependencies:
  build_runner: ^2.15.3
  react_codegen: {path: {{ packagesPath }}/react_codegen}
  react_tool: {path: {{ packagesPath }}/react_tool}
  react_testing: {path: {{ packagesPath }}/react_testing}
  lints: ^6.1.0
  test: ^1.31.2
  server_testing: ^0.4.0
  routed_testing:
    git:
      url: https://github.com/kingwill101/routed.git
      ref: master
      path: packages/server_testing/routed_testing

# The react_* packages are not published yet, so every package depends on
# them by path. The overrides keep a path package (for example react_dom's
# bare `react:` entry) resolving against the local copies.
dependency_overrides:
  react_core: {path: {{ packagesPath }}/react_core}
  react_js: {path: {{ packagesPath }}/react_js}
  react_dom: {path: {{ packagesPath }}/react_dom}
  react_web: {path: {{ packagesPath }}/react_web}
  react_actions: {path: {{ packagesPath }}/react_actions}
  react_server: {path: {{ packagesPath }}/react_server}
  react_testing: {path: {{ packagesPath }}/react_testing}
