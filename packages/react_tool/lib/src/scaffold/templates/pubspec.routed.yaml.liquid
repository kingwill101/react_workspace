name: {{ name }}
description: A React Dart application (SSR) hosted with Routed.
publish_to: none

environment:
  sdk: ">=3.12.0 <4.0.0"

dependencies:
  react_core: ^0.1.0
  react_js: ^0.1.0
  react_dom: ^0.1.0
  react_web: ^0.1.1
  react_actions: ^0.1.1
  react_server: ^0.1.1
  react_server_routed: ^0.1.1
  routed_core:
    git:
      url: https://github.com/kingwill101/routed.git
      ref: master
      path: packages/routed_core
  routed_io:
    git:
      url: https://github.com/kingwill101/routed.git
      ref: master
      path: packages/routed_io

dev_dependencies:
  build_runner: ^2.15.3
  react_codegen: ^0.1.0
  react_tool: ^0.2.2
  react_testing: ^0.1.0
  lints: ^6.1.0
  test: ^1.31.2
  server_testing: ^0.4.0
  routed_testing:
    git:
      url: https://github.com/kingwill101/routed.git
      ref: master
      path: packages/server_testing/routed_testing

{% if localPackages %}
# Local workspace overrides are enabled when `--packages` is supplied.
dependency_overrides:
  react_core: {path: {{ packagesPath }}/react_core}
  react_js: {path: {{ packagesPath }}/react_js}
  react_dom: {path: {{ packagesPath }}/react_dom}
  react_web: {path: {{ packagesPath }}/react_web}
  react_actions: {path: {{ packagesPath }}/react_actions}
  react_server: {path: {{ packagesPath }}/react_server}
  react_testing: {path: {{ packagesPath }}/react_testing}
  react_server_routed: {path: {{ packagesPath }}/react_server_routed}
{% endif %}
