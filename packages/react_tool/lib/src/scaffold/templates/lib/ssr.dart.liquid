import 'package:react_server/react_server.dart';

import 'package:{{ name }}/.generated/react/app.react.dart';
import 'package:{{ name }}/.generated/react_components.g.dart';
import 'package:{{ name }}/.generated/ssr_registry.g.dart';

void main() {
  registerReactComponents();
  SsrComponentRegistry.register(
    idApp.value,
    (props) => App(title: props['title'] as String? ?? 'Hello from SSR'),
  );
  registerGlobalRenderer((id, props) => SsrComponentRegistry.build(id, props));
}
