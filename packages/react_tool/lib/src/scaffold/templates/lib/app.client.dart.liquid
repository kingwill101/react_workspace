import 'package:react_dom/react_dom.dart';

/// Root component — client-only, no server functions.
/// Uses the typed host elements from `package:react_dom` in the browser.
@reactComponent
ReactNode App(({String title}) props) {
  return div(
    className: classNames('app-shell'),
    style: css(
      fontFamily: 'system-ui, sans-serif',
      maxWidth: 640,
      margin: '0 auto',
      padding: '48px 24px',
      textAlign: 'center',
    ),
    additionalProps: dataAttributes({'app': 'react-dart'}),
    children: [
      h1(key: 'title', children: [props.title]),
      div(
        key: 'welcome',
        children: ['Hello from the client — edit lib/react/app.dart to get started.'],
      ),
      div(
        key: 'instructions',
        children: ['Edit lib/react/app.dart and rebuild to see changes.'],
      ),
    ],
  );
}
